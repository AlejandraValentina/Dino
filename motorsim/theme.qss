/* Estilos de la aplicación; no modifican el escritorio de Windows. */
QWidget {
    background-color: #0b1326;
    color: #dae2fd;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QLabel { background: transparent; border: none; }
QLabel#pageTitle { font-size: 22pt; font-weight: 600; }
QMenuBar { background: #0d1729; padding: 0 10px; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #222e43; }
QMenu { background: #171f33; border: 1px solid #39475b; padding: 5px; }
QMenu::item { padding: 7px 26px 7px 12px; }
QMenu::item:selected { background: #24415b; }
QMenu::separator { height: 1px; background: #39475b; margin: 4px 8px; }
QToolBar {
    background: #0d1729; border: none; border-bottom: 1px solid #26344a;
    spacing: 6px; padding: 5px 14px;
}
QToolBar::separator { background: #34455c; width: 1px; margin: 5px 7px; }
QToolButton, QPushButton {
    background: #172338; color: #dae2fd; border: 1px solid #34455c;
    border-radius: 4px; padding: 5px 12px;
}
QToolButton:hover, QPushButton:hover { background: #22334b; border-color: #739fc5; }
QToolButton:pressed, QPushButton:pressed { background: #101c30; }
QPushButton:disabled { color: #687c94; background: #101a2b; border-color: #26344a; }
QToolButton:focus, QPushButton:focus { border: 2px solid #b0dcff; }
QToolButton#primaryAction { background: #3198dc; color: #002c47; border-color: #3198dc; font-weight: 600; }
QToolButton#primaryAction:hover { background: #69baf0; }
QToolButton#primaryAction:focus { border: 2px solid #d5efff; }
QLineEdit, QComboBox {
    background: #101b2e; color: #edf2ff; border: 1px solid #40546e;
    border-radius: 4px; padding: 7px 10px; min-height: 20px;
    selection-background-color: #315b80; selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #8bcfff; background: #142238; }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { width: 25px; border: none; }
QComboBox QAbstractItemView { background: #171f33; color: #dae2fd; selection-background-color: #24415b; }
QStatusBar { background: #0d1729; border-top: 1px solid #26344a; padding: 4px 8px; }
QStatusBar::item { border: none; }
QStatusBar QWidget { background: transparent; }
QStatusBar QLabel { font-size: 9pt; color: #9eb1c7; }
QLabel#projectState { color: #b9cfdf; }
QLabel#projectState[pending="true"] { color: #ffbf83; }
QFrame#statusDivider { color: #34455c; }
QToolTip { background: #172338; color: #edf2ff; border: 1px solid #739fc5; padding: 6px; }
QDialog, QMessageBox { background: #0b1326; }
QAbstractItemView {
    background: #101b2e; alternate-background-color: #172338; color: #dae2fd;
    border: 1px solid #39475b; selection-background-color: #24415b;
}
QHeaderView::section { background: #172338; color: #bfc7d2; border: none; padding: 6px; }
QGroupBox { border: 1px solid #26364d; border-radius: 5px; margin-top: 12px; font-size: 12pt; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; padding: 0 4px; color: #b4d9f5; }
QPlainTextEdit { background: #101b2e; color: #edf2ff; border: 1px solid #40546e; border-radius: 4px; padding: 7px; }
QPlainTextEdit:focus { border-color: #8bcfff; }
QLineEdit[invalid="true"] { border-color: #ee938b; }
QLabel#fieldError { color: #ffafa6; font-size: 9pt; }
QLabel#unit { color: #9eb1c7; }
QLabel#resultValue { color: #93ccff; font-size: 16pt; font-weight: 600; }
QScrollBar:vertical { background: #0d1729; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #34455c; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QTabWidget::pane { border: none; }
QListWidget::item { padding: 3px 6px; }
QListWidget::item:selected { background: #24415b; color: #edf2ff; }
QTabBar::tab { background: #0d1729; color: #9eb1c7; padding: 8px 22px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #b4d9f5; border-bottom-color: #69baf0; }
QTabBar::tab:focus { background: #24415b; }
QSlider::groove:horizontal { background: #34455c; height: 5px; }
QSlider::handle:horizontal { background: #69baf0; border: 1px solid #b4d9f5; width: 14px; margin: -5px 0; border-radius: 4px; }
QSlider::handle:horizontal:focus { background: #d5efff; border-color: #ffffff; }

QLabel#sectionTitle { font-size: 12pt; font-weight: 600; color: #b4d9f5; }

/* Navegación por tareas: siempre accesible, sin pestañas globales. */
QTreeWidget#navigation { border: none; border-right: 1px solid #26344a; padding: 12px 4px; background: #101a2b; }
QTreeWidget#navigation::item { padding: 8px 6px; border-left: 2px solid transparent; }
QTreeWidget#navigation::item:selected { background: #1b3850; border-left-color: #69baf0; color: #d9efff; }
QTreeWidget#navigation::item:focus { border: 1px solid #8bcfff; }
QLabel#pageTitle { font-size: 24pt; font-weight: 600; color: #edf4ff; }
QTabBar::tab { padding: 7px 12px; }

/* Superficies de trabajo: entrada, estado y consulta. */
QFrame#panel { background: #111e31; border: 1px solid #293d56; border-radius: 7px; }
QLabel#panelTitle { color: #8fbada; font-size: 9pt; font-weight: 600; padding-bottom: 4px; }
QLabel#subtitle { color: #b2c5dc; font-size: 11pt; }
QPushButton#primaryAction { background: #258bd0; color: #f2f9ff; border-color: #58b8f5; font-weight: 600; }
QPushButton#primaryAction:hover { background: #327fb2; }
QPushButton#primaryAction:disabled { background: #172338; color: #8396ae; border-color: #34455c; }
QPushButton#primaryAction:focus { border: 2px solid #d5efff; }
QTreeWidget#navigation { background: #101c2e; padding: 10px 6px; }
QTreeWidget#navigation::item { padding: 7px 8px; border-left: 3px solid transparent; }
QTreeWidget#navigation::item:hover { background: #1b3048; }
QTreeWidget#navigation::item:selected { background: #204761; border-left: 3px solid #7dd2ff; color: #ffffff; font-weight: 600; }
QTreeWidget#navigation::item:focus { border: 1px solid #b4e1ff; border-left: 3px solid #7dd2ff; }
